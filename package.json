{
  "name": "etalon-pravilo-studio",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js desktop/bundle release-desktop",
    "lint": "tsc --noEmit",
    "desktop:prepare": "node desktop/prepare-bundle.mjs",
    "desktop:install": "npm --prefix desktop install",
    "desktop:ensure": "node -e \"const fs=require('fs'),cp=require('child_process');if(!fs.existsSync('desktop/node_modules/electron-builder'))cp.execSync('npm --prefix desktop install',{stdio:'inherit'})\"",
    "desktop:mac": "npm run desktop:ensure && node desktop/prepare-bundle.mjs && npm --prefix desktop run dist:mac:only",
    "desktop:mac:universal": "npm run desktop:ensure && node desktop/prepare-bundle.mjs && npm --prefix desktop run dist:mac:universal:only",
    "desktop:win": "npm run desktop:ensure && node desktop/prepare-bundle.mjs && npm --prefix desktop run dist:win:only",
    "dist:mac": "npm run desktop:mac",
    "dist:mac:universal": "npm run desktop:mac:universal",
    "dist:win": "npm run desktop:win",
    "android:prepare": "node android/prepare-android-apps.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.6.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
